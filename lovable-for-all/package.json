{
  "name": "hatchery-studio",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "TURBO_UI=tui turbo dev --ui=tui",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:push": "turbo db:push",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "prettier": "^3.5.3",
    "typescript": "^5.7.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "eslint-config-next": "16.2.10",
    "next": "16.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
